# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[user]
	name = nick-gorse
	email = nick@olb42.com
	signingkey = 3C2095E7BE94E7F7
	signingkey = ~/.ssh/id_script.pub
[core]
	excludesFile = ~/gitignore
	pager = delta
[webui]
	autoupdate = true
[instaweb]
	browser = open
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[help]
	autocorrect = 1
[rerere]
	enabled = true
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[credential "https://git.olb42.com"]
	useHttpPath = true
	helper =
	helper = !GITEA_CLI_CONFIG_DIR=~/.config/gitea-cli ~/.local/bin/gt auth git-credential --host https://git.olb42.com
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
