#autoload
mise_init_project() {
  local root_ns="olb42"
  local ref='{{vars.tasks_ref | default(value='"'"'main'"'"')}}'

  if [ -e mise.toml ] || [ -e .mise.toml ]; then
    echo "✗ A mise config already exists here — merge the include in by hand:"
    echo "    add the [task_config].includes line and [vars].image, plus a"
    echo "    [env].REGISTRY_NAMESPACE override if this repo's owner isn't ${root_ns}."
    return 1
  fi

  local url owner repo
  url=$(git remote get-url origin 2>/dev/null) || { echo "✗ no git remote 'origin'"; return 1; }
  url=${url%.git}
  repo=${url##*/}
  url=${url%/*}
  owner=${url##*/}

  {
    echo '[task_config]'
    echo """includes = [
        \"git::https://git.olb42.com/olb042/mise-tasks.git//docker.toml?ref=${ref}\",
        \"git::https://git.olb42.com/olb042/mise-tasks.git//release.toml?ref=${ref}\"
        ]"""
    echo ''
    echo '[vars]'
    echo "# Published image name — defaults to the repo name; adjust if it differs."
    echo "image = \"${repo}\""
    if [[ -d "${PWD}/charts" ]]; then
      echo "helm_repo = \"${owner}\""
    fi
    echo ''
    echo '[env]'
    echo "PROJECT_ROOT = \"{{ config_root }}\""
    if [ "$owner" != "$root_ns" ]; then
      echo "# This repo's owner (${owner}) differs from the root default (${root_ns})."
      echo "REGISTRY_NAMESPACE = \"${owner}\""
    fi
  } > mise.toml

  echo "✓ wrote mise.toml (image=${repo}, namespace=${owner})"
  echo "  Review the image name, then: mise trust && mise :docker:build"
}